@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' Your task (Chapter 8, Question 1): draw the UML class diagram for the library
' specification — items, books, DVDs, reference-only items, members, librarians,
' and holds.
'
' Define each type as a box, then connect them with the right arrows. One box
' (Item) is filled in as an example — decide on the rest yourself. There is more
' than one defensible answer.
'
' PlantUML cheat-sheet:
'   interface Name { + method() : Type }
'   abstract class Name { # field : Type }
'   class Name { - field : Type }
'   Parent    <|-- Child    ' generalization: Child extends Parent
'   Interface <|.. Class    ' realization:    Class implements Interface
' (Putting the parent/interface on the LEFT of the arrow keeps it on top, which
'  is the convention used in these notes.)

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

enum ItemFormat {
  BOOK
  DVD
}

interface Borrowable {
  + borrow(member : Member) : void
  + returnItem() : void
  + isOnLoan() : boolean
  + placeHold(member : Member) : Hold
}

class BorrowableItem {
  - loanPeriodDays : int
  - borrower : Member
  - holds : List<Hold>
  + borrow(member : Member) : void
  + returnItem() : void
  + isOnLoan() : boolean
  + placeHold(member : Member) : Hold
  + getLoanPeriodDays() : int
}

class ReferenceItem

class Member {
  - memberNumber : String
  - lateFee : double
  + placeHold(item : Borrowable) : Hold
  + waiveLateFee() : void
}

class Librarian {
  + addItem(item : Item, catalogue : Catalogue) : void
  + waiveLateFee(member : Member) : void
}

class Catalogue {
  - items : Map<String, Item>
  + addItem(item : Item) : void
  + findItem(catalogueNumber : String) : Item
}

class Library {
  - members : Map<String, Member>
  - catalogue : Catalogue
  + login(memberNumber : String) : Member
}

class Hold {
  - member : Member
  - item : BorrowableItem
}

Item : - format : ItemFormat
Item <|-- BorrowableItem
Item <|-- ReferenceItem
Borrowable <|.. BorrowableItem
Item --> "1" ItemFormat : format
Library --> "1" Catalogue
Library --> "0..*" Member : registered members
Catalogue --> "0..*" Item : indexed by unique catalogue number
BorrowableItem --> "0..1" Member : current borrower
BorrowableItem "1" *-- "0..*" Hold : ordered queue
Hold --> "1" Member : requested by
Member ..> Borrowable : places hold
Librarian ..> Catalogue : adds item
Librarian ..> Member : waives fee

note right of BorrowableItem
  Book: loanPeriodDays = 21
  DVD: loanPeriodDays = 7
  isOnLoan iff borrower != null
  borrow requires no current borrower
  placeHold requires isOnLoan()
end note

note bottom of Catalogue
  addItem rejects duplicate catalogue numbers
end note

@enduml
